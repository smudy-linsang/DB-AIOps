#!/usr/bin/env bash
# pre-commit: 秒级本地反馈。
#
# 定位说明（相对 Agent H 方案的调整）：
# 本钩子只是辅助安全网 —— 它是本地文件、不随仓库分发、可用 --no-verify 跳过、
# 且对在云端容器里工作的 Agent 完全无效。CI 是事后信号，不是合并门禁
# （本仓库直推 master，无 ruleset、无分支保护），本地验证是唯一的闸。
# 这里只做秒级检查，帮开发者在本地提前发现低级错误。
#
# 2026-08-10：接入 scripts/validate.sh unit —— 将验证从声明状态（AGENTS.md /
# .qoder/rules/validation.md 文档）接入实际执行路径。每次提交 Python 文件时
# 自动跑单元测试（~10s，零外部依赖，SQLite 内存库）。
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0
for v in .venv venv; do [ -f "$v/bin/activate" ] && { . "$v/bin/activate"; break; }; done

# 失败状态强制复验：编辑时刻钩子（.qoder/hooks/）在验证失败或环境异常放行时
# 会保留 logs/qoder-edit-validate.fail。任何提交（不限 Python 文件）进入交付前
# 都必须先复验通过并清除该状态，堵住"钩子放行后直接 commit"的漏洞。
STATE_FILE="logs/qoder-edit-validate.fail"
if [ -f "$STATE_FILE" ]; then
  echo "[pre-commit] 检测到未解除的编辑后验证失败状态（${STATE_FILE}），强制复验"
  # set -u 下用 || rc=$? 惯用法取退出码
  scripts/validate.sh unit --json >/dev/null 2>&1 || rc=$?
  rc=${rc:-0}
  if [ "$rc" -eq 0 ]; then
    rm -f "$STATE_FILE"
    echo "[pre-commit] 复验通过，已清除失败状态"
  else
    echo "[pre-commit] 复验未通过（退出码 ${rc}），禁止提交。运行 scripts/validate.sh unit 查看详情；"
    echo "             若为环境错误，修复环境后重试。失败记录：$(cat "$STATE_FILE" 2>/dev/null)"
    exit 1
  fi
fi

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
  echo "[pre-commit] 语法检查 $(echo "$STAGED_PY" | wc -l | tr -d ' ') 个文件"
  # shellcheck disable=SC2086
  python -m compileall -q $STAGED_PY || { echo "[pre-commit] 语法错误"; exit 1; }
  python manage.py check >/dev/null 2>&1 || { echo "[pre-commit] manage.py check 未通过"; exit 1; }
  # 接入验证脚本：unit 层测试（~10s，零外部依赖）
  scripts/validate.sh unit --json >/dev/null 2>&1 || {
    echo "[pre-commit] 单元测试未通过，运行 scripts/validate.sh unit 查看详情"; exit 1; }
  echo "[pre-commit] 单元测试 PASS"
fi
python scripts/scan_secrets.py >/dev/null 2>&1 || {
  echo "[pre-commit] 疑似密钥，运行 python scripts/scan_secrets.py 查看"; exit 1; }
echo "[pre-commit] PASS"
